9023 0 obj
  << /ActualText (The RPC node answers with block N\047s call tree\054 one CallFrame per transaction\054 each frame embedding its children as calls\072 Vec\074CallFrame\076 \056 serde\137json recursive parser enforces a default nesting limit of 128 levels\073 the engine never lifts it\056 A call tree costs two JSON nesting levels per frame each frame is a JSON object inside its parent\047s calls array\056 So the attacker crafts the depth such that the trace for block N exceeds the budget\072 a 63\055frame tree still parses\054 a 64\055frame tree fails with recursion limit exceeded\056 The error fires inside the deserializer\054 before the engine\047s own trace\055to\055body validation \050check\137trace\137matches\137block\137body\051 ever runs\056\nThe \077 on let mut block \075 ctx\056chain\137reader\056fetch\137observed\137block\050height\051\056await\077\073 propagates the parse failure out of the per\055height loop and out of fold\072\072advance itself\056 No part of the turn commits\072 the per\055event transaction never opens\054 and cursor\056last\137block\054 cursor\056last\137tick keep their previous values so the fold stays pinned below block N\056\nBack in the runner\054 the error is examined\072)
     /K [ 1 ]
     /P 9024 0 R
     /Pg 3373 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

9024 0 obj
  << /K [ 9023 0 R ]
     /P 9031 0 R
     /S /P
     /Pg 3373 0 R
     /Type /StructElem
  >>
endobj

9025 0 obj
  << /ActualText (let folded \075 fold\072\072advance\050ctx\054 \046mut tenant\137states\054 \046mut cursor\054 safe\137head\051\056await\073\nlet fold\137succeeded \075 folded\056is\137ok\050\051\073\n\nif let Err\050err\051 \075 folded \173\n    if err\056downcast\137ref\072\072\074ReorgDetected\076\050\051\056is\137some\050\051 \173\n        tracing\072\072error\041\050\n            error \075 format\041\050\042\173err\072\043\175\042\051\054\n            \042heartbeat\072 reorg below the trust horizon \204 A3 violation\054 shutting down\042\n        \051\073\n        return Err\050err\051\073\n    \175\n    tracing\072\072error\041\050\n        error \075 format\041\050\042\173err\072\043\175\042\051\054\n        \042heartbeat\072 fold failed\073 retrying next block\042\n    \051\073\n\175)
     /K [ 2 ]
     /P 9026 0 R
     /Pg 3373 0 R
     /S /Span
